{
  "name": "hunkwise",
  "publisher": "local",
  "displayName": "hunkwise",
  "description": "Per-hunk Accept/Discard for any file change",
  "version": "0.0.29-stable.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/molon/hunkwise"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hunkwise.enable",
        "title": "hunkwise: Enable"
      },
      {
        "command": "hunkwise.disable",
        "title": "hunkwise: Disable"
      },
      {
        "command": "hunkwise.openSettings",
        "title": "hunkwise: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "hunkwise.refresh",
        "title": "hunkwise: Refresh State",
        "icon": "$(refresh)"
      },
      {
        "command": "hunkwise.nextHunk",
        "title": "hunkwise: Next Hunk",
        "icon": "$(arrow-down)"
      },
      {
        "command": "hunkwise.prevHunk",
        "title": "hunkwise: Previous Hunk",
        "icon": "$(arrow-up)"
      },
      {
        "command": "hunkwise.acceptHunkAtCursor",
        "title": "hunkwise: Accept Hunk at Cursor",
        "icon": "$(check)"
      },
      {
        "command": "hunkwise.discardHunkAtCursor",
        "title": "hunkwise: Discard Hunk at Cursor",
        "icon": "$(discard)"
      },
      {
        "command": "hunkwise.openHunkDiff",
        "title": "hunkwise: Open Diff for Hunk",
        "icon": "$(diff)"
      },
      {
        "command": "hunkwise.acceptAllInFile",
        "title": "hunkwise: Accept All Hunks in File",
        "icon": "$(check-all)"
      },
      {
        "command": "hunkwise.discardAllInFile",
        "title": "hunkwise: Discard All Hunks in File",
        "icon": "$(discard)"
      },
      {
        "command": "hunkwise.acceptHunk",
        "title": "hunkwise: Accept Hunk"
      },
      {
        "command": "hunkwise.discardHunk",
        "title": "hunkwise: Discard Hunk"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hunkwise.refresh",
          "when": "view == hunkwiseToolbar",
          "group": "navigation"
        },
        {
          "command": "hunkwise.openSettings",
          "when": "view == hunkwiseToolbar",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "hunkwise.editorContext",
          "when": "resourceScheme == file && hunkwise.hasHunks",
          "group": "hunkwise@1"
        }
      ],
      "commandPalette": [
        {
          "command": "hunkwise.acceptHunk",
          "when": "false"
        },
        {
          "command": "hunkwise.discardHunk",
          "when": "false"
        },
        {
          "command": "hunkwise.nextHunk",
          "when": "hunkwise.hasHunks"
        },
        {
          "command": "hunkwise.prevHunk",
          "when": "hunkwise.hasHunks"
        },
        {
          "command": "hunkwise.acceptHunkAtCursor",
          "when": "hunkwise.hasHunks"
        },
        {
          "command": "hunkwise.discardHunkAtCursor",
          "when": "hunkwise.hasHunks"
        },
        {
          "command": "hunkwise.openHunkDiff",
          "when": "hunkwise.hasHunks"
        },
        {
          "command": "hunkwise.acceptAllInFile",
          "when": "hunkwise.hasHunks"
        },
        {
          "command": "hunkwise.discardAllInFile",
          "when": "hunkwise.hasHunks"
        }
      ],
      "hunkwise.editorContext": [
        {
          "command": "hunkwise.acceptHunkAtCursor",
          "group": "1_hunk@1"
        },
        {
          "command": "hunkwise.discardHunkAtCursor",
          "group": "1_hunk@2"
        },
        {
          "command": "hunkwise.openHunkDiff",
          "group": "1_hunk@3"
        },
        {
          "command": "hunkwise.nextHunk",
          "group": "2_nav@1"
        },
        {
          "command": "hunkwise.prevHunk",
          "group": "2_nav@2"
        },
        {
          "command": "hunkwise.acceptAllInFile",
          "group": "3_file@1"
        },
        {
          "command": "hunkwise.discardAllInFile",
          "group": "3_file@2"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "hunkwisePanel",
          "title": "hunkwise",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hunkwisePanel": [
        {
          "id": "hunkwiseToolbar",
          "name": "hunkwise",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hunkwise.nextHunk",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorTextFocus && hunkwise.hasHunks"
      },
      {
        "command": "hunkwise.prevHunk",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorTextFocus && hunkwise.hasHunks"
      },
      {
        "command": "hunkwise.acceptHunkAtCursor",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "editorTextFocus && hunkwise.hasHunks"
      },
      {
        "command": "hunkwise.discardHunkAtCursor",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && hunkwise.hasHunks"
      },
      {
        "command": "hunkwise.acceptAllInFile",
        "key": "ctrl+shift+alt+y",
        "mac": "cmd+shift+alt+y",
        "when": "editorTextFocus && hunkwise.hasHunks"
      },
      {
        "command": "hunkwise.discardAllInFile",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n",
        "when": "editorTextFocus && hunkwise.hasHunks"
      }
    ],
    "submenus": [
      {
        "id": "hunkwise.editorContext",
        "label": "hunkwise"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "rm -rf out-test && tsc -p ./tsconfig.test.json && mkdir -p out-test/node_modules/vscode && cp out-test/test/__mocks__/vscode.js out-test/node_modules/vscode/index.js && node --test out-test/test/*.test.js",
    "test:integration": "npm run compile && tsc -p ./tsconfig.integration.json && vscode-test"
  },
  "devDependencies": {
    "@types/diff": "^5.x",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.37",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.x"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "ignore": "^7.0.5"
  }
}
